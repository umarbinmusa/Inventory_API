# Server
PORT=4000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# MongoDB
MONGO_URI=mongodb://localhost:27017/ledger

# JWT
JWT_ACCESS_SECRET=change-me
JWT_REFRESH_SECRET=change-me-too
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Password reset token
RESET_TOKEN_EXPIRES_MIN=30

# Email (for forgot password / notifications)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="Ledger <no-reply@example.com>"

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=200

# Cloudinary (product image uploads)
# Easiest: paste the single "API Environment variable" string shown on your
# Cloudinary dashboard (Settings > API Keys) - it looks like:
#   cloudinary://<api_key>:<api_secret>@<cloud_name>
# If CLOUDINARY_URL is set, the three vars below are ignored.
CLOUDINARY_URL=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
